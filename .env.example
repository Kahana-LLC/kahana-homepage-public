# Cloudinary (required for optimized images; otherwise images fall back to local /public paths)
# Get your cloud name from https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Product Hunt global banner preview (local only; omit in production)
# prelaunch — "Launching on Product Hunt May 27" (default before launch day)
# live — launch-day badge + "We're live on Product Hunt"
# NEXT_PUBLIC_PH_LAUNCH_PREVIEW=prelaunch
