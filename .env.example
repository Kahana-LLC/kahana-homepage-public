# Canonical public site URL (used for SEO, sitemaps, and canonical links)
NEXT_PUBLIC_SITE_URL=https://kahana.io

# Cloudinary (required for optimized images; otherwise images fall back to local /public paths)
# Get your cloud name from https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Product Hunt celebration preview (local only; omit in production)
# celebration (or legacy live / true) — force celebration UI on
# off — hide celebration UI locally
# NEXT_PUBLIC_PH_LAUNCH_PREVIEW=celebration
