{
  "name": "kahana-homepage-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "rm -rf .next",
    "build": "NODE_ENV=production VERBOSE=false npm run clean && NODE_OPTIONS='--no-deprecation' next build",
    "start": "next start -p $PORT",
    "lint": "next lint",
    "update-sitemap": "node scripts/update-sitemap.js",
    "upload-blog-images": "node scripts/upload-blog-images-to-cloudinary.js",
    "upload-external-blog-images": "node scripts/upload-external-blog-images-to-cloudinary.js",
    "upload-all-blog-images": "node scripts/upload-blog-images-to-cloudinary.js && node scripts/upload-external-blog-images-to-cloudinary.js",
    "upload-to-cloudinary-and-remove-local": "node scripts/upload-blog-images-to-cloudinary.js --remove-local && node scripts/upload-external-blog-images-to-cloudinary.js",
    "upload-author-headshots": "node scripts/upload-author-headshots-to-cloudinary.js",
    "upload-assets": "node scripts/upload-assets-to-cloudinary.js",
    "upload-all-project-images": "node scripts/upload-all-project-images-to-cloudinary.js",
    "fix-failed-blog-images": "node scripts/fix-and-upload-failed-blog-images.js",
    "normalize-blog-em-dashes": "node scripts/normalize-blog-em-dashes.js --write",
    "normalize-blog-em-dashes:dry-run": "node scripts/normalize-blog-em-dashes.js --verbose",
    "analyze-blog-long-anchors": "node scripts/analyze-blog-long-anchor-text.js --verbose",
    "analyze-blog-long-anchors:dry-run": "node scripts/analyze-blog-long-anchor-text.js",
    "fix-blog-long-anchors": "node scripts/analyze-blog-long-anchor-text.js --write",
    "images:inventory-hosts": "node scripts/image-host-inventory.js",
    "images:validate-hosts": "node scripts/validate-image-hosts.js",
    "lighthouse:check": "node scripts/check-lighthouse-thresholds.js",
    "perf:budget": "node scripts/check-performance-budgets.js",
    "perf:verify": "npm run build && npm run perf:budget && npm run images:validate-hosts && npm run lighthouse:check",
    "analyze": "ANALYZE=true NODE_OPTIONS='--no-deprecation' next build",
    "heroku-postbuild": "npm run clean && NODE_OPTIONS='--no-deprecation' next build && npm run images:validate-hosts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@headlessui/react": "^1.7.3",
    "@heroicons/react": "^2.0.12",
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/supabase-js": "^2.88.0",
    "@tabler/icons-react": "^3.31.0",
    "algoliasearch": "^4.22.1",
    "axios": "^1.8.4",
    "chart.js": "^4.4.9",
    "cloudinary": "^2.8.0",
    "clsx": "^1.2.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^7.10.3",
    "mixpanel-browser": "^2.74.0",
    "next": "^14.1.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-lite-youtube-embed": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-instantsearch": "^7.7.0",
    "react-instantsearch-dom": "^6.40.4",
    "sharp": "^0.33.5",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "14.2.35",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.8",
    "autoprefixer": "^10.4.21",
    "chokidar": "^3.5.3",
    "eslint": "8.26.0",
    "eslint-config-next": "14.1.3",
    "fast-xml-parser": "^4.2.2",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.1",
    "postcss": "^8.4.18",
    "postcss-nesting": "^13.0.1",
    "tailwindcss": "^3.2.1"
  },
  "optionalDependencies": {
    "@next/codemod": "^15.3.0",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.10.3",
    "pexels": "^1.4.0",
    "react-syntax-highlighter": "^15.5.0",
    "react-to-pdf": "^2.0.0"
  },
  "description": "This is a [Next.js](https://nextjs.org/) project bootstrapped with [`create-next-app`](https://github.com/vercel/next.js/tree/canary/packages/create-next-app).",
  "main": "next.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
